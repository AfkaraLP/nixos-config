diff --git a/ggml/src/ggml-cuda/wstream.inc b/ggml/src/ggml-cuda/wstream.inc
new file mode 100644
index 0000000..c30462a
--- /dev/null
+++ b/ggml/src/ggml-cuda/wstream.inc
@@ -0,0 +1,302 @@
+// Host weight streaming ("wstream").
+//
+// With partial offload, large-batch ops on CPU-resident layers are still run on the GPU and the
+// scheduler re-uploads their weights on every graph compute. Those uploads are synchronous and
+// interleaved with the compute, so the PCIe link idles whenever the CPU or GPU is busy, and the
+// GPU idles while the link is busy.
+//
+// This keeps a small VRAM ring that a worker thread fills ahead of the consumer, in the order in
+// which the scheduler is going to ask for the weights. The scheduler's copy then becomes a
+// device-to-device copy out of the ring. After the last weight of a graph the worker keeps going
+// with the start of the same sequence, which is what the next graph compute asks for first.
+//
+// Enabled with GGML_CUDA_WSTREAM_MB=<ring size in MiB>.
+
+#include <chrono>
+#include <deque>
+#include <thread>
+
+struct ggml_cuda_wstream {
+    enum item_state { PENDING, UPLOADING, READY, CONSUMED, DIRECT };
+
+    struct item {
+        const void * host  = nullptr;
+        size_t       size  = 0;
+        size_t       alloc = 0;
+        size_t       off   = 0;
+        int          split = 0;
+        uint64_t     pass  = 0;  // graph compute this item belongs to
+        item_state   st    = PENDING;
+        bool         live  = false; // occupies ring space
+        cudaEvent_t  done  = nullptr; // completes when the GPU has copied the item out of the ring
+    };
+
+    int    device = 0;
+    size_t cap    = 0;
+    char * base   = nullptr;
+
+    std::mutex              m;
+    std::condition_variable cv;
+    std::thread             worker;
+    bool                    stop = false;
+
+    std::deque<item> q;          // front = oldest item still tracked
+    size_t   next_upload = 0;    // index into q
+    size_t   next_consume = 0;   // index into q
+    size_t   head = 0;           // ring bump pointer
+    uint64_t pass = 0;
+    std::vector<item> last_plan; // sequence of the current pass, replayed as lookahead
+
+    std::vector<cudaEvent_t> event_pool;
+
+    // stats
+    uint64_t n_hit = 0, n_miss = 0, n_direct = 0, bytes_up = 0;
+    double   t_wait = 0.0;
+    bool     debug = false;
+
+    // ring space: live items form a FIFO run, possibly wrapped
+    bool ring_alloc(size_t a, size_t & off) {
+        size_t tail = 0;
+        bool any = false;
+        for (const auto & it : q) {
+            if (it.live) { tail = it.off; any = true; break; }
+        }
+        if (!any) {
+            head = 0;
+            if (a > cap) return false;
+            off = 0; head = a;
+            return true;
+        }
+        if (head > tail) { // not wrapped
+            if (head + a <= cap) { off = head; head += a; return true; }
+            if (a < tail)        { off = 0;    head = a;  return true; }
+            return false;
+        }
+        // wrapped (or full)
+        if (head + a <= tail && head != tail) { off = head; head += a; return true; }
+        return false;
+    }
+
+    void drop_front() {
+        while (!q.empty() && !q.front().live && (q.front().st == CONSUMED || q.front().st == DIRECT) && next_consume > 0 && next_upload > 0) {
+            q.pop_front();
+            next_consume--;
+            next_upload--;
+        }
+    }
+
+    void run() {
+        ggml_cuda_set_device(device);
+        cudaStream_t stream;
+        CUDA_CHECK(cudaStreamCreateWithFlags(&stream, cudaStreamNonBlocking));
+        std::unique_lock<std::mutex> lock(m);
+        while (true) {
+            size_t off = 0;
+            bool got = false;
+            while (!stop && !got) {
+                while (next_upload < q.size() && q[next_upload].st == DIRECT) next_upload++;
+                if (next_upload >= q.size()) {
+                    cv.wait(lock);
+                    continue;
+                }
+                release_consumed();
+                got = ring_alloc(q[next_upload].alloc, off);
+                if (!got) {
+                    // space is held by items the GPU has not copied out yet, poll their events
+                    cv.wait_for(lock, std::chrono::microseconds(100));
+                }
+            }
+            if (stop) break;
+            item & it = q[next_upload]; // deque references stay valid across push_back / pop_front of other elements
+            it.off  = off;
+            it.live = true;
+            it.st   = UPLOADING;
+            const void * host = it.host;
+            const size_t size = it.size;
+            lock.unlock();
+            CUDA_CHECK(cudaMemcpyAsync(base + off, host, size, cudaMemcpyHostToDevice, stream));
+            CUDA_CHECK(cudaStreamSynchronize(stream));
+            lock.lock();
+            bytes_up += size;
+            it.st = READY;
+            next_upload++;
+            cv.notify_all();
+        }
+        cudaStreamDestroy(stream);
+    }
+
+    // free the ring space of the consumed items the GPU is done reading
+    void release_consumed() {
+        for (auto & it : q) {
+            if (it.st != CONSUMED || !it.live) continue;
+            if (cudaEventQuery(it.done) != cudaSuccess) {
+                (void) cudaGetLastError();
+                break; // FIFO: later items complete later
+            }
+            event_pool.push_back(it.done);
+            it.done = nullptr;
+            it.live = false;
+        }
+        drop_front();
+    }
+
+    void plan(ggml_backend_t * backends, const ggml_tensor ** srcs, const int * split_ids, int n);
+    bool copy(ggml_backend_t backend, const ggml_tensor * src, ggml_tensor * dst, int split_id);
+};
+
+static ggml_cuda_wstream * g_cuda_wstream = nullptr;
+
+void ggml_cuda_wstream::plan(ggml_backend_t * backends, const ggml_tensor ** srcs, const int * split_ids, int n) {
+    std::vector<item> cur;
+    cur.reserve(n);
+    ggml_backend_t backend = nullptr;
+    for (int i = 0; i < n; i++) {
+        if (!ggml_backend_is_cuda(backends[i])) continue;
+        ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backends[i]->context;
+        if (cuda_ctx->device != device) continue;
+        backend = backends[i];
+        item it;
+        it.host  = srcs[i]->data;
+        it.size  = ggml_nbytes(srcs[i]);
+        it.alloc = GGML_PAD(it.size, 256);
+        it.split = split_ids[i];
+        cur.push_back(it);
+    }
+    if (cur.empty()) {
+        return;
+    }
+
+    std::unique_lock<std::mutex> lock(m);
+    pass++;
+    release_consumed();
+
+    // keep the lookahead that matches the start of this plan
+    size_t n_keep = 0;
+    bool   match  = true;
+    for (size_t i = next_consume; i < q.size(); i++) {
+        const size_t k = i - next_consume;
+        if (k >= cur.size() || q[i].host != cur[k].host || q[i].size != cur[k].size || q[i].st == DIRECT) {
+            match = false;
+            break;
+        }
+        n_keep++;
+    }
+    if (!match) {
+        // unexpected sequence: wait for an in-flight upload, then drop the whole lookahead
+        cv.wait(lock, [&] {
+            for (const auto & it : q) if (it.st == UPLOADING) return false;
+            return true;
+        });
+        while (q.size() > next_consume) {
+            q.pop_back();
+        }
+        next_upload = std::min(next_upload, q.size());
+        n_keep = 0;
+        // the bump pointer continues after the newest item still in the ring
+        for (const auto & it : q) if (it.live) head = it.off + it.alloc;
+    }
+    for (size_t k = 0; k < n_keep; k++) {
+        q[next_consume + k].split = cur[k].split;
+        q[next_consume + k].pass  = pass;
+    }
+    for (size_t k = n_keep; k < cur.size(); k++) {
+        item it = cur[k];
+        it.pass = pass;
+        if (it.alloc > cap) it.st = DIRECT;
+        q.push_back(it);
+    }
+    // lookahead: the next graph compute most likely starts with the same sequence
+    size_t ahead = 0;
+    for (size_t k = 0; k < cur.size() && ahead + cur[k].alloc <= cap; k++) {
+        item it = cur[k];
+        it.pass = pass + 1;
+        if (it.alloc > cap) break;
+        ahead += it.alloc;
+        q.push_back(it);
+    }
+    if (debug) {
+        fprintf(stderr, "wstream: pass %llu: %zu weights, kept %zu, hit %llu miss %llu direct %llu, uploaded %.1f MiB, waited %.1f ms\n",
+            (unsigned long long) pass, cur.size(), n_keep, (unsigned long long) n_hit, (unsigned long long) n_miss,
+            (unsigned long long) n_direct, bytes_up / 1048576.0, t_wait * 1e3);
+    }
+    n_hit = n_miss = n_direct = 0; bytes_up = 0; t_wait = 0.0;
+    cv.notify_all();
+}
+
+bool ggml_cuda_wstream::copy(ggml_backend_t backend, const ggml_tensor * src, ggml_tensor * dst, int split_id) {
+    if (!ggml_backend_is_cuda(backend)) {
+        return false;
+    }
+    ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
+    if (cuda_ctx->device != device) {
+        return false;
+    }
+
+    std::unique_lock<std::mutex> lock(m);
+    GGML_UNUSED(split_id);
+
+    if (next_consume >= q.size() || q[next_consume].host != src->data || q[next_consume].size != ggml_nbytes(src) || q[next_consume].pass != pass) {
+        n_miss++;
+        return false;
+    }
+    item & it = q[next_consume];
+    if (it.st == DIRECT) {
+        next_consume++;
+        n_direct++;
+        return false;
+    }
+    const int64_t t0 = ggml_time_us();
+    cv.wait(lock, [&] { return it.st == READY; });
+    t_wait += (ggml_time_us() - t0) * 1e-6;
+
+    CUDA_CHECK(cudaMemcpyAsync(dst->data, base + it.off, it.size, cudaMemcpyDeviceToDevice, cuda_ctx->stream()));
+    if (event_pool.empty()) {
+        cudaEvent_t ev;
+        CUDA_CHECK(cudaEventCreateWithFlags(&ev, cudaEventDisableTiming));
+        event_pool.push_back(ev);
+    }
+    it.done = event_pool.back();
+    event_pool.pop_back();
+    CUDA_CHECK(cudaEventRecord(it.done, cuda_ctx->stream()));
+    it.st = CONSUMED;
+    next_consume++;
+    n_hit++;
+    return true;
+}
+
+static void ggml_cuda_wstream_plan(ggml_backend_t * backends, const ggml_tensor ** srcs, const int * split_ids, int n) {
+    if (g_cuda_wstream) g_cuda_wstream->plan(backends, srcs, split_ids, n);
+}
+
+static bool ggml_cuda_wstream_copy(ggml_backend_t backend, const ggml_tensor * src, ggml_tensor * dst, int split_id) {
+    return g_cuda_wstream && g_cuda_wstream->copy(backend, src, dst, split_id);
+}
+
+static void ggml_cuda_wstream_init(int device) {
+    static std::mutex init_mutex;
+    std::lock_guard<std::mutex> lock(init_mutex);
+    if (g_cuda_wstream != nullptr) {
+        return;
+    }
+    const int mb = ggml_cuda_env_int("GGML_CUDA_WSTREAM_MB", 0);
+    if (mb <= 0) {
+        return;
+    }
+    auto * ws = new ggml_cuda_wstream;
+    ws->device = device;
+    ws->cap    = (size_t) mb * 1024 * 1024;
+    ws->debug  = ggml_cuda_env_flag("GGML_CUDA_WSTREAM_DEBUG");
+    ggml_cuda_set_device(device);
+    if (cudaMalloc((void **) &ws->base, ws->cap) != cudaSuccess) {
+        (void) cudaGetLastError();
+        GGML_LOG_WARN("wstream: failed to allocate a %d MiB ring, disabled\n", mb);
+        delete ws;
+        return;
+    }
+    ws->worker = std::thread([ws] { ws->run(); });
+    ws->worker.detach();
+    g_cuda_wstream = ws;
+    static const ggml_backend_wstream_hooks hooks = { ggml_cuda_wstream_plan, ggml_cuda_wstream_copy };
+    ggml_backend_sched_set_wstream_hooks(&hooks);
+    GGML_LOG_INFO("wstream: streaming host weights through a %d MiB ring on device %d\n", mb, device);
+}
