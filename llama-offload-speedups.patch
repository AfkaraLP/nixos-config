+// Every break in the prompt is one more decode. With partial offload a decode costs a full upload of the
+// weights whatever its size, so only break for the checkpoint a follow-up request restores: the one right
+// before the end of the prompt.
+static bool server_ckpt_tail_only() {
+    static const bool res = getenv("LLAMA_SERVER_CKPT_TAIL_ONLY") != nullptr;
+    return res;
+}
+
+// longest replay batch that still gets a new draft appended, 0 disables it; the recurrent snapshots that let
+// the tail of such a batch be rolled back are only taken in short ubatches
+static int server_spec_replay_max_tokens() {
+    static const int n = []() {
+        const char * env = getenv("LLAMA_SPEC_REPLAY_DRAFT_MAX");
+        return env ? atoi(env) : 96;
+    }();
+    return n;
+}
+
+// replay of an accepted prefix with a fresh draft appended to it: the first n_replay tokens were accepted
+// before the checkpoint restore and are accepted again, the rest of the draft is verified as usual
+static std::vector<llama_token> server_accept_replay_and_verify(
+        common_sampler * smpl,
+        llama_context * ctx,
+        const std::vector<int32_t> & idxs,
+        const llama_tokens & draft,
+        size_t n_replay) {
+    GGML_ASSERT(idxs.size() == draft.size() + 1);
+    GGML_ASSERT(n_replay <= draft.size());
+
+    const llama_vocab * vocab = llama_model_get_vocab(llama_get_model(ctx));
+
+    std::vector<llama_token> result;
+    result.reserve(idxs.size());
+
+    for (size_t i = 0; i < n_replay; ++i) {
+        // the token is discarded - the call is what advances the sampler over this position
+        common_sampler_sample(smpl, ctx, idxs[i]);
+        common_sampler_accept(smpl, draft[i], true);
+        result.push_back(draft[i]);
+    }
+
+    size_t i = n_replay;
+    for (; i < draft.size(); ++i) {
+        const llama_token id = common_sampler_sample(smpl, ctx, idxs[i]);
+        common_sampler_accept(smpl, id, true);
+        result.push_back(id);
+
+        if (draft[i] != id || (llama_vocab_is_eog(vocab, id) && i + 1 < draft.size())) {
+            break;
+        }
+    }
+
+    if (i == draft.size()) {
+        const llama_token id = common_sampler_sample(smpl, ctx, idxs[i]);
+        common_sampler_accept(smpl, id, true);
+        result.push_back(id);
+    }
+
+    return result;
+}
